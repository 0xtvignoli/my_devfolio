# Environment Variables for my_devfolio
# Copy this file to .env.local and fill in your actual values

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here

# Google Analytics Measurement ID (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:9004

# Cloudflare (optional — for scripts/cloudflare-apply-security.sh)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=tvignoli.com
# CLOUDFLARE_ACCOUNT_ID=

# Contact form (both required, or the form stays hidden and the mailto is used)
#   RESEND_API_KEY:      https://resend.com/api-keys  (free tier is plenty)
#   CONTACT_FROM_EMAIL:  must be on the domain you VERIFIED in Resend, exactly.
#                        A `from` on a subdomain of it is a different domain as
#                        far as the provider is concerned, and answers 403.
#                        Not the visitor's address — replies use reply_to.
#
# Verifying the apex is enough and needs no SPF change on the apex: Resend puts
# the return-path on send.<domain> (SES custom MAIL FROM), so an apex
# "v=spf1 -all" is never consulted for this mail and DMARC still passes through
# DKIM, which aligns strictly with the apex From.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=portfolio@tvignoli.com

# Cloudflare Turnstile (optional — set BOTH or neither).
# The secret alone makes the form reject every message (no token is sent);
# the site key alone widens the CSP for a widget that can't be verified.
#
# To re-verify the integration without a real widget, use Cloudflare's official
# dummy keys — all four paths were checked with these:
#   pass:  NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#          TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   block: TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
# Expected: token + pass-secret -> gets past the challenge; no token while a
# secret is set -> 403; token + block-secret -> 403; and the production CSP gains
# challenges.cloudflare.com only while a site key is present.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
