# Environment Variables for my_devfolio
# Copy this file to .env.local and fill in your actual values

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here

# Google Analytics Measurement ID (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:9004

# Cloudflare (optional — for scripts/cloudflare-apply-security.sh)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=tvignoli.com
# CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Turnstile (optional — enable after creating widget in dashboard)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
