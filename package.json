  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --turbopack -p 9004",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "build:bun": "bun --bun next build",
