{
  "name": "my_devfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --turbopack -p 9004",
    "build": "bun scripts/observatory.ts && next build",
    "observatory": "bun scripts/observatory.ts",
    "build:bun": "bun --bun next build",
    "start": "next start",
    "start:bun": "bun --bun next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test src --preload=./test-setup.ts",
    "test:watch": "bun test src --watch --preload=./test-setup.ts",
    "test:e2e": "playwright test",
    "audit": "bun audit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^10.5.0",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  }
}
